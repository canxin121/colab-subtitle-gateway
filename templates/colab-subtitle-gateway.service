# colab-sg notebook launcher — systemd user service
#
# This unit is intentionally only a local recovery loop. The notebook owns all
# deployment/configuration logic; keep CONFIG["mode"] = "deploy" in colab-sg.ipynb.
# Replace the placeholders before installing:
#   __EXEC__     absolute path to the colab executable
#   __SESSION__  Colab session name (same as CONFIG["session"])
#   __GPU__      GPU variant (same as CONFIG["gpu"])
#   __NOTEBOOK__ absolute path to colab-sg.ipynb
#   __PATH__     PATH including the colab executable's directory
#
# Install as ~/.config/systemd/user/colab-subtitle-gateway.service, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now colab-subtitle-gateway
#   sudo loginctl enable-linger "$USER"   # optional: run when logged out
#
# Inspect/restart/remove:
#   systemctl --user status colab-subtitle-gateway
#   journalctl --user -u colab-subtitle-gateway -f
#   systemctl --user disable --now colab-subtitle-gateway

[Unit]
Description=Run the colab-sg deployment notebook and recover Colab sessions
Documentation=https://github.com/canxin121/colab-subtitle-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="PATH=__PATH__"
ExecStart=/bin/bash -c "while :; do if \"__EXEC__\" status -s \"__SESSION__\" 2>&1 | grep -F \"Session '__SESSION__' not found.\" >/dev/null; then \"__EXEC__\" new --gpu \"__GPU__\" -s \"__SESSION__\" || true; fi; \"__EXEC__\" exec -s \"__SESSION__\" -f \"__NOTEBOOK__\" --timeout 21600 || true; sleep 120; done"
Restart=always
RestartSec=30

# The loop writes progress and errors to the journal. It deliberately retries
# after a failed exec; colab exec output includes notebook cell diagnostics.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
