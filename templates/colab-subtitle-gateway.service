# colab-sg 的 systemd 模板 (Linux 常驻保活)
#
# 一般不需要手改: `colab-sg service install` 会按你当前的参数生成并启用单元。
# 这份模板给需要手改 (加环境变量、改重启策略) 或想装成系统级服务的场景。
#
# 用户级安装 (推荐, 不需要 root):
#   mkdir -p ~/.config/systemd/user
#   cp colab-subtitle-gateway.service ~/.config/systemd/user/
#   # 把 __EXEC__ 换成 bin/colab-sg 的绝对路径
#   systemctl --user daemon-reload
#   systemctl --user enable --now colab-subtitle-gateway
#   # 未登录也常驻 (否则只在登录会话里跑):
#   sudo loginctl enable-linger "$USER"
#
# 系统级安装 (开机即跑, 与登录无关): 放到 /etc/systemd/system/, 加上
#   User=<你的用户名>  和  Environment=HOME=/home/<用户>
#
# 常用:
#   systemctl --user status  colab-subtitle-gateway
#   systemctl --user restart colab-subtitle-gateway
#   journalctl --user -u colab-subtitle-gateway -f

[Unit]
Description=colab-sg watch — 在 Colab GPU 上保活 subtitle-gateway 并维持公网入口
Documentation=https://github.com/canxin121/colab-subtitle-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# __EXEC__ 换成 bin/colab-sg 的绝对路径; 参数按需增删
ExecStart=__EXEC__ watch -s colab-sg -g T4 --port 8000 --interval 120

Restart=always
RestartSec=30

# colab CLI 需要; 若用 uv 装的工具也在这个 PATH 上
Environment=PATH=/usr/local/bin:/usr/bin:/bin

# 可选: 每次公网地址变化时的钩子 ($CSG_URL / $CSG_OLD_URL 可用)
# Environment=CSG_ON_URL_CHANGE=/usr/bin/curl -s "https://example.com/hook?url=$CSG_URL"

# 让日志进 journal
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
