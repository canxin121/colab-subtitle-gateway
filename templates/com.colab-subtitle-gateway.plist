<?xml version="1.0" encoding="UTF-8"?>
<!--
  colab-sg notebook launcher — launchd user agent.

  The notebook owns deployment/configuration. Keep CONFIG["mode"] = "deploy"
  in colab-sg.ipynb. Replace these placeholders before installing:
    __EXEC__     absolute path to the colab executable
    __SESSION__  Colab session name (same as CONFIG["session"])
    __GPU__      GPU variant (same as CONFIG["gpu"])
    __NOTEBOOK__ absolute path to colab-sg.ipynb
    __PATH__     PATH including the colab executable's directory
    __STATE__    existing directory for launchd logs

  Install:
    mkdir -p ~/Library/LaunchAgents __STATE__
    cp com.colab-subtitle-gateway.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.colab-subtitle-gateway.plist 2>/dev/null || true
    launchctl load ~/Library/LaunchAgents/com.colab-subtitle-gateway.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.colab-subtitle-gateway.plist
    rm ~/Library/LaunchAgents/com.colab-subtitle-gateway.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.colab-subtitle-gateway</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>while :; do if "__EXEC__" status -s "__SESSION__" 2&gt;&amp;1 | grep -F "Session '__SESSION__' not found." &gt;/dev/null; then "__EXEC__" new --gpu "__GPU__" -s "__SESSION__" || true; fi; "__EXEC__" exec -s "__SESSION__" -f "__NOTEBOOK__" --timeout 21600 || true; sleep 120; done</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__STATE__/service.out.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE__/service.err.log</string>
</dict>
</plist>
